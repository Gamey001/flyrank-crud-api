# Copy to .env and adjust. .env is gitignored; this file is committed.
#
# Leave DATABASE_URL unset (or commented out) to fall back to the SQLite
# repository from Assignment 2 with no other change.

# Credentials the Postgres container is created with.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Host port the database is published on. 5433 avoids clashing with a
# PostgreSQL already running natively on the default 5432.
POSTGRES_PORT=5433

# Connection string used by the app.
# Inside docker compose the host is the service name, "db".
DATABASE_URL=postgresql://tasks:change-me@db:5432/tasks

# When running the app on your machine against the container, use localhost
# and the published port instead:
# DATABASE_URL=postgresql://tasks:change-me@localhost:5433/tasks
